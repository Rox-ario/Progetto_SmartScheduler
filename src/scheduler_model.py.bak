from ortools.sat.python import cp_model

class SmartSchedulerModel:
    def __init__(self, num_workers, num_days):
        self.model = cp_model.CpModel()
        self.num_workers = num_workers
        self.num_days = num_days

        # Shift variables: shifts[(w, d, s)] is true if worker w works shift s on day d.
        self.shifts = {}
        for w in range(self.num_workers):
            for d in range(self.num_days):
                for s in range(3): # 0: Morning, 1: Afternoon, 2: Night
                    self.shifts[(w, d, s)] = self.model.NewBoolVar(f'shift_w{w}_d{d}_s{s}')

        # Satisfaction weights for the objective function
        self.satisfaction_weights = {}
        for w in range(self.num_workers):
            for d in range(self.num_days):
                for s in range(3):
                    self.satisfaction_weights[(w, d, s)] = 0 # Initialized to 0, will be populated by preferences

        # Shift properties based on the draft
        self.shift_durations = {
            0: 6,  # Morning shift (08:00 - 14:00)
            1: 6,  # Afternoon shift (14:00 - 20:00)
            2: 12  # Night shift (20:00 - 08:00)
        }

        self.shift_weights = {
            0: 1,  # Morning shift
            1: 1,  # Afternoon shift
            2: 2   # Night shift
        }

    def build_base_constraints(self):
        # HC4_MAX_ONE_SHIFT_PER_DAY: Each worker can cover up to one shift per day.
        # Logic: The sum of boolean assignments for Shift 0, 1, and 2 for a specific worker on a specific day must be <= 1.
        for w in range(self.num_workers):
            for d in range(self.num_days):
                self.model.Add(sum(self.shifts[(w, d, s)] for s in range(3)) <= 1)

        # HC1_MAX_HOURS_PER_WEEK: Each employee's working time cannot exceed 36 hours per week.
        # Logic: In any rolling 7-day window, the sum of hours worked (6 for Morning/Afternoon, 12 for Night) by a single worker must be <= 36.
        for w in range(self.num_workers):
            for d in range(self.num_days - 6): # Rolling 7-day window (d to d+6)
                total_hours_in_window = sum(
                    self.shifts[(w, day, s)] * self.shift_durations[s]
                    for day in range(d, d + 7)
                    for s in range(3)
                )
                self.model.Add(total_hours_in_window <= 36)

        # HC2_MONTHLY_WORKLOAD: Each worker must cover exactly 25 shifts in a month.
        # Logic: The sum of "Shift Weights" (Morning=1, Afternoon=1, Night=2) for each worker across the 31-day horizon must be exactly equal to 25.
        for w in range(self.num_workers):
            total_weighted_shifts = sum(
                self.shifts[(w, d, s)] * self.shift_weights[s]
                for d in range(self.num_days)
                for s in range(3)
            )
            self.model.Add(total_weighted_shifts == 25)

        # HC3_NIGHT_SHIFT_REST: It is mandatory to ensure each employee two free days after each night shift.
        # Logic: If a worker is assigned Shift 2 (Night) on Day D, they must have 0 shifts assigned on Day D+1 and Day D+2.
        for w in range(self.num_workers):
            for d in range(self.num_days - 2): # Need d+1 and d+2
                # If worker w works night shift on day d
                night_shift_on_d = self.shifts[(w, d, 2)]
                
                # Then worker w must not work on day d+1
                self.model.Add(sum(self.shifts[(w, d + 1, s)] for s in range(3)) == 0).OnlyEnforceIf(night_shift_on_d)
                
                # And worker w must not work on day d+2
                self.model.Add(sum(self.shifts[(w, d + 2, s)] for s in range(3)) == 0).OnlyEnforceIf(night_shift_on_d)

        # HC5_NO_SUBSEQUENT_SHIFTS: A worker cannot cover two subsequent shifts.
        # Logic: Prevents back-to-back shift assignments. Specifically, a worker cannot do Shift 1 (Afternoon) on Day D and Shift 0 (Morning) on Day D+1.
        for w in range(self.num_workers):
            for d in range(self.num_days - 1): # Need d and d+1
                # If worker w works afternoon shift on day d
                afternoon_shift_on_d = self.shifts[(w, d, 1)]
                
                # Then worker w must not work morning shift on day d+1
                self.model.Add(self.shifts[(w, d + 1, 0)] == 0).OnlyEnforceIf(afternoon_shift_on_d)

        # HC6_MANDATORY_WEEKLY_REST: Each worker must be ensured a day of rest.
        # Logic: In any consecutive 7-day block, every worker must have at least one completely free day (0 shifts assigned).
        for w in range(self.num_workers):
            for d in range(self.num_days - 6): # Rolling 7-day block (d to d+6)
                # Due to HC4, sum(self.shifts[(w, day, s)] for s in range(3)) is 0 or 1.
                # So, sum of these over 7 days is the count of working days in the window.
                # To ensure at least one free day, the count of working days must be <= 6.
                total_working_days_in_window = sum(
                    sum(self.shifts[(w, day, s)] for s in range(3))
                    for day in range(d, d + 7)
                )
                self.model.Add(total_working_days_in_window <= 6)

    def apply_preferences(self):
        """
        Metodo dedicato all'iniezione delle preferenze generate dalla Fase 1.
        Gli alias locali espongono gli attributi della classe con i nomi
        che il codice generato da Gemini si aspetta.
        NON modificare i nomi degli alias: sono il contratto con il LLM.
        """
        model = self.model
        shifts = self.shifts
        satisfaction_weights = self.satisfaction_weights

        # <<< PREFERENCES_INJECTION_POINT >>>

    def build_objective(self):
        # Maximize the sum of weighted assigned shifts
        variables = [self.shifts[(w, d, s)] for w in range(self.num_workers) for d in range(self.num_days) for s in range(3)]
        coefficients = [self.satisfaction_weights[(w, d, s)] for w in range(self.num_workers) for d in range(self.num_days) for s in range(3)]
        
        self.model.Maximize(cp_model.LinearExpr.WeightedSum(variables, coefficients))

    def solve(self):
        solver = cp_model.CpSolver()
        status = solver.Solve(self.model)
        return (status, solver)